# TATA SALES — Production environment template
# 1) cp .env.production.example .env
# 2) Ganti setiap placeholder: <...>
# 3) php artisan key:generate
# 4) JANGAN commit .env ke git (sudah di .gitignore)

APP_NAME=TATA Sales
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<domain-anda>
APP_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database: Supabase existing (session pooler 5432 / transaction 6543) ---
DB_CONNECTION=pgsql
# Cara termudah — satu URL:
DB_URL=postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
# DB_HOST=<dibiarkan kosong jika DB_URL dipakai>
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- Mail: default log; ganti kalau butuh kirim nyata ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@<domain-anda>"
MAIL_FROM_NAME="${APP_NAME}"

# --- LLM / AI agent (wajib untuk fitur AI) ---
LLM_PROVIDER=openai
LLM_API_KEY=<api-key-gemini>
LLM_MODEL=gemini-3-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_API_KEY=<api-key-groq>
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- WhatsApp ──(opsional, dalam 2 opsi)──
# Opsi A: jumlah pesan "timpa" saja — provider echo (tanpa API), CTA wa.me tetap jalan
WHATSAPP_DRIVER=echo
WHATSAPP_DEFAULT_PHONE=<nomor-628xxxxxxxxxx>

# Opsi B: kirim pesan sungguhan via Meta Cloud API
# WHATSAPP_DRIVER=meta
# WHATSAPP_META_TOKEN=<token-system-user>
# WHATSAPP_META_PHONE_NUMBER_ID=<nomor-bisnis-id>

# --- CRM outbound (opsional, default echo) ---
CRM_DRIVER=echo
# CRM_DRIVER=hubspot
# CRM_HUBSPOT_API_KEY=<token>
# CRM_HUBSPOT_BASE_URL=https://api.hubapi.com/crm/v3
# CRM_HUBSPOT_PIPELINE_ID=<id>
# CRM_HUBSPOT_STAGE_NEW=<id>
# CRM_HUBSPOT_STAGE_WON=<id>
# CRM_HUBSPOT_STAGE_LOST=<id>